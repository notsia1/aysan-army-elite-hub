# ---------------------------------------------------------------------------
# Aysan Army Elite Training Club — yerel geliştirme ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayın:  cp .env.example .env
# `.env` dosyası git'e gönderilmez. Buraya gerçek anahtar YAZMAYIN.
# ---------------------------------------------------------------------------

# --- Lovable Cloud (veritabanı + yönetici girişi) --------------------------
# Lovable'da otomatik sağlanır. Yerelde iletişim formu ve /giris ekranının
# çalışması için gerekir. Değerleri Lovable projesindeki .env dosyasından
# kopyalayabilirsiniz (tarayıcıya açık, gizli değildir).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Sunucu tarafı (SSR) için aynı değerler:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Google Haritalar verisi (adres, puan, yorumlar, fotoğraflar) ---------
# SEÇENEK A — Lovable ağ geçidi: bu iki değişken SADECE Lovable sunucularında
# otomatik sağlanır, yerelde elde edilemez. Yerelde boş bırakın.
LOVABLE_API_KEY=
GOOGLE_MAPS_API_KEY=

# SEÇENEK B — Kendi Google Cloud anahtarınız (yerelde canlı veri için).
# Google Cloud Console > "Places API (New)" etkinleştirin, API anahtarı
# oluşturun ve buraya yazın. Anahtar yalnızca sunucuda kullanılır.
GOOGLE_PLACES_API_KEY=
